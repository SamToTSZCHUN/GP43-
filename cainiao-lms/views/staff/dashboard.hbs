{{!-- Staff Dashboard - frontend-staff --}}

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Staff Dashboard</h2>
    <a href="/staff/packages/create" class="btn btn-warning">Receive parcel</a>
  </div>

  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h6 class="text-muted">Total Parcels</h6>
          <h3>{{totalParcels}}</h3>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h6 class="text-muted">Waiting for Shelf</h6>
          <h3>{{waitingForShelf}}</h3>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h6 class="text-muted">Ready for Pickup</h6>
          <h3>{{readyForPickup}}</h3>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h6 class="text-muted">Exceptions</h6>
          <h3>{{exceptionsCount}}</h3>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      Parcel Registry
    </div>
    <div class="card-body">
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Tracking</th>
            <th>Recipient</th>
            <th>Type</th>
            <th>Status</th>
            <th>Pickup Code</th>
          </tr>
        </thead>
        <tbody>
          {{#each packages}}
          <tr>
            <td><a href="/staff/packages/{{id}}">{{trackingNo}}</a></td>
            <td>{{recipientName}}</td>
            <td>{{type}}</td>
            <td>{{status}}</td>
            <td>{{#if pickupCode}}{{pickupCode}}{{else}}-{{/if}}</td>
          </tr>
          {{else}}
          <tr>
            <td colspan="5" class="text-center">No parcels yet.</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>
